{
  "name": "onedrive-vercel-index",
  "packageManager": "pnpm@12.5.1",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint src/components src/pages src/utils src/types config *.config.js i18next.config.ts --diagnostic-level=error --skip=lint/a11y --skip=lint/complexity/noUselessFragments --skip=lint/suspicious/noArrayIndexKey --skip=lint/security/noDangerouslySetInnerHtml",
    "format": "prettier 'src/**/*.{js,ts,jsx,tsx}' --write",
    "extract": "i18next-cli extract",
    "test": "vitest run"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@headlessui/react": "^2.2.10",
    "@intity/epub-js": "^0.3.98",
    "@vercel/analytics": "^2.0.1",
    "axios": "^1.20.0",
    "cors": "^2.8.6",
    "dayjs": "^1.11.23",
    "emoji-regex": "^11.0.0",
    "i18next": "^26.4.2",
    "ioredis": "^6.0.0",
    "js-sha256": "^1.0.0",
    "jszip": "^3.10.2",
    "katex": "^0.18.7",
    "mpegts.js": "^1.8.2",
    "next": "^16.3.5",
    "next-i18next": "^16.3.1",
    "nextjs-progressbar": "^0.0.16",
    "plyr-react": "^6.0.0",
    "preview-office-docs": "^1.0.2",
    "react": "^19.3.0",
    "react-async-hook": "^4.0.0",
    "react-audio-player": "^0.17.0",
    "react-cookie": "^8.1.2",
    "react-dom": "^19.3.0",
    "react-hot-toast": "^2.6.1",
    "react-hotkeys-hook": "^5.3.3",
    "react-i18next": "^17.0.14",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "swr": "^2.5.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/cors": "^2.8.19",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "i18next-cli": "^1.74.1",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "lodash": "^4.18.1"
  },
  "prettier": {
    "printWidth": 120,
    "arrowParens": "avoid",
    "singleQuote": true,
    "semi": false,
    "plugins": [
      "prettier-plugin-tailwindcss"
    ]
  }
